{
  "name": "farmaslog-api",
  "version": "1.0.0",
  "description": "FarmasLog-API: farmer and farm verification service",
  "main": "src/server.js",
  "scripts": {
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "seed": "node scripts/seed.js",
    "import": "node scripts/import-farmers.js",
    "postman": "node scripts/build-postman.js",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "sample": "node scripts/make-sample-webform-csv.js",
    "import:webform": "node scripts/import-webform.js",
    "smoke": "node scripts/smoke.js",
    "test:db": "cross-env TEST_MONGODB_URI=mongodb://127.0.0.1:27017/farmaslog_test NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
