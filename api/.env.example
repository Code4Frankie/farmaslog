NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/farmaslog
# Required in production (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h
# Secret used to HMAC lookup values in verification logs (so raw phone numbers are never logged)
LOOKUP_HMAC_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_SERVER_VERIFY=true
UPLOAD_DIR=./uploads
CORS_ORIGINS=
# Open decision #3: exact coordinates are never returned unless this is true AND the API key has the coordinates:read scope
VERIFY_INCLUDE_COORDINATES=false
NDVI_THRESHOLD=0.3
AREA_DISCREPANCY_TOLERANCE=0.3
# Test/staging helpers
ALLOW_SYNTHETIC=                 # true only on staging; defaults to true outside production
SEED_ADMIN_EMAIL=admin@farmaslog.local
SEED_ADMIN_PASSWORD=             # optional, min 12 chars; otherwise a random one is printed once
# First deploy on a host with no shell: creates ONE super admin if none exists. Remove both after your first sign-in.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# Consent text details (shown to farmers; unset values appear as [bracketed] gaps until you fill them)
CONSENT_REGISTERED_ADDRESS=
# Contact details default to frankiecode.org.ng/about. An administrator can edit all six in the dashboard (Consent info);
# a saved value beats these variables.
CONSENT_CONTACT_EMAIL=
CONSENT_CONTACT_PHONE=
CONSENT_CONTACT_WHATSAPP=
CONSENT_RETENTION_PERIOD=         # e.g. "2 years"
CONSENT_HOSTING=                  # e.g. "MongoDB Atlas (AWS, Ireland) and Render (Frankfurt)"
# One-time codes by SMS (Termii) and Cloudflare Turnstile. See docs/OPERATIONS.md.
TERMII_API_KEY=
TERMII_SENDER_ID=FarmasLog        # must be registered with Termii before it delivers in Nigeria
TERMII_CHANNEL=dnd                # dnd reaches numbers on Do-Not-Disturb; generic is cheaper
TURNSTILE_SECRET=
CAPTCHA_REQUIRED=                 # defaults to true in production; false only for staging tests
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=3
OTP_RESEND_SECONDS=30
HIDE_NEEDS_RECONSENT=false        # true = records with old consent wording stop appearing in partner verification
