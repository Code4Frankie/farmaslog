{
  "info": {
    "name": "FarmasLog-API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set baseUrl, then log in to fill token. Use only test keys (sk_test_...) and synthetic phone numbers. Change the state, lga and community variables to demo any area."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "apiKey",
      "value": ""
    },
    {
      "key": "state",
      "value": "Nasarawa"
    },
    {
      "key": "lga",
      "value": "Awe"
    },
    {
      "key": "community",
      "value": "Agwatashi"
    },
    {
      "key": "farmerId",
      "value": ""
    },
    {
      "key": "partnerId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Partner verification",
      "item": [
        {
          "name": "Verify by phone (200/404/429)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/verify?phone=08000000001&state={{state}}&lga={{lga}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ],
              "query": [
                {
                  "key": "phone",
                  "value": "08000000001"
                },
                {
                  "key": "state",
                  "value": "{{state}}"
                },
                {
                  "key": "lga",
                  "value": "{{lga}}"
                }
              ]
            }
          }
        },
        {
          "name": "Verify by FarmasLog ID",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/verify?farmaslogId=FL-00000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ],
              "query": [
                {
                  "key": "farmaslogId",
                  "value": "FL-00000000"
                }
              ]
            }
          }
        },
        {
          "name": "Missing params (400)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{apiKey}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ]
            }
          }
        },
        {
          "name": "No key (401)",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "noauth"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/verify?phone=08000000001",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verify"
              ],
              "query": [
                {
                  "key": "phone",
                  "value": "08000000001"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@farmaslog.local\",\n  \"password\": \"<from seed output>\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "login"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json(); if (j.token) pm.collectionVariables.set('token', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "auth",
                "me"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Farmers",
      "item": [
        {
          "name": "Register farmer (synthetic)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test Farmer\",\n  \"phone\": \"08000000002\",\n  \"state\": \"{{state}}\",\n  \"lga\": \"{{lga}}\",\n  \"community\": \"{{community}}\",\n  \"consent\": {\n    \"given\": true,\n    \"wordingVersion\": \"v1\"\n  },\n  \"isSynthetic\": true,\n  \"farm\": {\n    \"crop\": \"White yam\",\n    \"reportedAreaHa\": 1.5,\n    \"location\": {\n      \"lat\": 7,\n      \"lng\": 9,\n      \"source\": \"farmer_pin\",\n      \"accuracyMeters\": 20\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers"
              ]
            }
          }
        },
        {
          "name": "List farmers",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers?state={{state}}&lga={{lga}}&limit=25",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers"
              ],
              "query": [
                {
                  "key": "state",
                  "value": "{{state}}"
                },
                {
                  "key": "lga",
                  "value": "{{lga}}"
                },
                {
                  "key": "limit",
                  "value": "25"
                }
              ]
            }
          }
        },
        {
          "name": "Get farmer",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers/{{farmerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers",
                "{{farmerId}}"
              ]
            }
          }
        },
        {
          "name": "Approve",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"approve\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers/{{farmerId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers",
                "{{farmerId}}",
                "review"
              ]
            }
          }
        },
        {
          "name": "Field verification",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"outcome\": \"verified\",\n  \"method\": \"site_visit\",\n  \"location\": {\n    \"lat\": 7,\n    \"lng\": 9,\n    \"accuracyMeters\": 8\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers/{{farmerId}}/field-verification",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers",
                "{{farmerId}}",
                "field-verification"
              ]
            }
          }
        },
        {
          "name": "Queue enrichment",
          "request": {
            "method": "POST",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/farmers/{{farmerId}}/enrich",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "farmers",
                "{{farmerId}}",
                "enrich"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Partners & keys",
      "item": [
        {
          "name": "Create partner",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"organization\": \"Test Bank\",\n  \"type\": \"bank\",\n  \"plan\": \"free\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/partners",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "partners"
              ]
            }
          }
        },
        {
          "name": "Create API key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sandbox\",\n  \"mode\": \"test\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/partners/{{partnerId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "partners",
                "{{partnerId}}",
                "api-keys"
              ]
            }
          }
        },
        {
          "name": "List keys",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/partners/{{partnerId}}/api-keys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "partners",
                "{{partnerId}}",
                "api-keys"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Reporting",
      "item": [
        {
          "name": "Usage",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/usage?groupBy=month",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "usage"
              ],
              "query": [
                {
                  "key": "groupBy",
                  "value": "month"
                }
              ]
            }
          }
        },
        {
          "name": "Verification logs",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/verification-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "verification-logs"
              ]
            }
          }
        },
        {
          "name": "Audit logs",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/v1/audit-logs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "v1",
                "audit-logs"
              ]
            }
          }
        }
      ]
    }
  ]
}